{
  "name": "avanti-cabinet-vue3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:limits && npm run lint:inline && npm run lint:js && npm run lint:css && npm run lint:format",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{vue,scss}\"",
    "lint:limits": "node scripts/check_file_limits.mjs",
    "lint:inline": "node scripts/check_inline_styles.mjs",
    "lint:format": "prettier --check \"src/**/*.{vue,ts,scss}\"",
    "format": "prettier --write \"src/**/*.{vue,ts,scss}\""
  },
  "dependencies": {
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "eslint": "^9.19.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.4.2",
    "sass-embedded": "^1.83.4",
    "stylelint": "^16.14.1",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vue-tsc": "^2.2.0"
  }
}
